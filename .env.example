# Forms (public, called from the browser)
NEXT_PUBLIC_NEWSLETTER_WEBHOOK=
NEXT_PUBLIC_CONTACT_WEBHOOK=

# Chat assistant (server-side only, never exposed to the browser)
N8N_CHAT_WEBHOOK_URL=
N8N_CHAT_SECRET=

# Rate limiting (server-side only)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Pricing (public, both optional)
# Blueprint delivery workflow. Empty = Blueprint requests go to the newsletter
# webhook and the visitor is told the Blueprint lands once it's published.
NEXT_PUBLIC_BLUEPRINT_WEBHOOK=
# Stripe Payment Link for the $39 site template. Empty = "coming soon" text.
NEXT_PUBLIC_TEMPLATE_CHECKOUT_URL=
